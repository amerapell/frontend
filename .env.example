# Base URL of the NestJS API (no trailing slash, without /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of this storefront (used for canonical URLs, OG tags, sitemap, WhatsApp links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudinary cloud name; when set, next/image uses the Cloudinary loader
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# "true" serves the bundled mock dataset instead of calling the API (demos, design QA)
NEXT_PUBLIC_USE_MOCKS=false
# Store WhatsApp number in international format without "+" (fallback when settings.whatsappNumber is empty)
NEXT_PUBLIC_WHATSAPP_NUMBER=2348000000000
